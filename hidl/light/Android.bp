package {
    default_applicable_licenses: ["lilac_legacy_light_license"],
}

license {
    name: "lilac_legacy_light_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["NOTICE"],
}

// Keep the frozen Android ABI for the Sony HIDL clients in this product.
hidl_package_root {
    name: "android.hardware.light",
    use_current: true,
    require_frozen: true,
}
