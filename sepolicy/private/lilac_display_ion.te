# The 4.4 kernel still uses ION for legacy gralloc and media buffers.
allow {
    hal_fingerprint
    hal_graphics_allocator
    hal_graphics_composer
    mediaswcodec
    platform_app
    priv_app
    surfaceflinger
    system_app
    system_server
} ion_device:chr_file r_file_perms;
allow bootanim ion_device:chr_file rw_file_perms;

# Vulkan capability detection loads the legacy Adreno driver in gpuservice.
allow gpuservice ion_device:chr_file { getattr open read ioctl };
allowxperm gpuservice ion_device:chr_file ioctl { 0x4900-0x4902 0x4904 0x4905 0x4907 };
