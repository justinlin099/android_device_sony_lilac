LOCAL_PATH := $(call my-dir)

# Copy the BTF generated by the same kernel link into the G8441 boot ramdisk.
ifeq ($(TARGET_PRODUCT),lineage_lilac)
lilac_kernel_obj := $(TARGET_OUT_INTERMEDIATES)/KERNEL_OBJ
lilac_kernel_image := $(lilac_kernel_obj)/arch/arm64/boot/$(BOARD_KERNEL_IMAGE_NAME)
lilac_kernel_btf := $(lilac_kernel_obj)/vmlinux.btf.xz
$(lilac_kernel_image): .KATI_IMPLICIT_OUTPUTS += $(lilac_kernel_btf)

include $(CLEAR_VARS)
LOCAL_MODULE := lilac_kernel_btf
LOCAL_MODULE_CLASS := ETC
LOCAL_MODULE_STEM := lilac-vmlinux.btf.xz
LOCAL_MODULE_PATH := $(TARGET_RAMDISK_OUT)
LOCAL_PREBUILT_MODULE_FILE := $(lilac_kernel_btf)
LOCAL_LICENSE_KINDS := SPDX-license-identifier-GPL-2.0-only
LOCAL_LICENSE_CONDITIONS := restricted
LOCAL_NOTICE_FILE := kernel/sony/msm8998/COPYING
include $(BUILD_PREBUILT)
endif

ifneq ($(filter lilac, $(TARGET_DEVICE)),)
include $(call all-subdir-makefiles,$(LOCAL_PATH))
endif
